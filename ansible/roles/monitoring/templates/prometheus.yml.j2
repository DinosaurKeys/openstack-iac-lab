global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - /etc/prometheus/lab-alerts.yml
scrape_configs:
  - job_name: nodes
    static_configs:
{% for host in groups.get('lab_nodes', []) + groups.get('app', []) + groups.get('database', []) %}
      - targets: ['{{ hostvars[host].private_ip | default(hostvars[host].ansible_host) }}:9100']
        labels:
          host: {{ host }}
{% endfor %}
      - targets: ['127.0.0.1:9100']
        labels:
          host: monitor1
  - job_name: app_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['{{ app_probe_url }}']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
