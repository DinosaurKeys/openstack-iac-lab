clouds:
  iac-lab:
    auth_type: v3applicationcredential
    auth:
      auth_url: http://192.168.0.100:5000/v3
      application_credential_id: REPLACE_WITH_YOUR_NEW_LAB_CREDENTIAL_ID
      application_credential_secret: REPLACE_WITH_YOUR_NEW_LAB_CREDENTIAL_SECRET
    region_name: RegionOne
    interface: public
    identity_api_version: '3'
